  "repo_root": "/home/hatch/workspace/BroadcastContentAutomation",
  "script_provider_env": "groq-helper",
  "services": {
    "_comment": "Reachability probes only (any HTTP response, even 401, proves the endpoint is up). No quota is burned. These do NOT check quota \u2014 a Pollinations 402 (Quest Pollen exhausted) or an Azure 429 only shows up in a prep log.",
