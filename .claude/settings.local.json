{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(uv tool *)",
      "Bash(graphifyy --help)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git check-ignore *)",
      "Bash(git count-objects *)",
      "Bash(git rm *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(graphify query *)",
      "Skill(claude-api)",
      "Skill(claude-api:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/rishi/.local/bin/headroom.EXE init hook ensure --profile init-business-7bb142dd --marker headroom-init-claude",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/rishi/.local/bin/headroom.EXE init hook ensure --profile init-business-7bb142dd --marker headroom-init-claude",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "headroom@headroom-marketplace": true
  }
}
